<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAM_OCCT\SAM.Core.OCCT\SAM.Core.OCCT.csproj" />
    <ProjectReference Include="..\SAM_OCCT\SAM.Geometry.OCCT\SAM.Geometry.OCCT.csproj" />
    <ProjectReference Include="..\SAM_OCCT\SAM.Analytical.OCCT\SAM.Analytical.OCCT.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SAM.Core">
      <HintPath>..\..\SAM\build\SAM.Core.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry">
      <HintPath>..\..\SAM\build\SAM.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical">
      <HintPath>..\..\SAM\build\SAM.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Math">
      <HintPath>..\..\SAM\build\SAM.Math.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\*.sam" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildNativeOcct" BeforeTargets="Build" Condition="'$(SAM_OCCT_SKIP_NATIVE_BUILD)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build-native.ps1&quot; -Configuration $(Configuration) -SkipVcpkgInstall" />
  </Target>

  <!-- The OCCT managed projects load SAM.Occt.Native by name. Copy the native bridge,
       OCCT runtime DLLs, and VC runtime DLLs next to the test assembly. -->
  <ItemGroup>
    <None Include="..\build\SAM.Occt.Native.dll;..\build\TK*.dll;..\build\tbb*.dll;..\build\jemalloc.dll;..\build\concrt140.dll;..\build\msvcp*.dll;..\build\vcamp140.dll;..\build\vccorlib140.dll;..\build\vcomp140.dll;..\build\vcruntime*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
