// H12 release-provenance stamping (Q3 2026).
//
// This file is a CMake configure_file(...) template. It is only configured and
// added to the SAM.Occt.Native target when SAMVersion is supplied by the CI/release
// build (see CMakeLists.txt). A local developer build does not use this resource at
// all - existing local build behaviour is unchanged.
//
// Metadata only: this does not alter exports, the native ABI (sam_occt_abi_version()),
// linking, or any OCCT API usage.

#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @SAM_OCCT_FILEVERSION_CSV@
 PRODUCTVERSION @SAM_OCCT_FILEVERSION_CSV@
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L
 FILETYPE       0x2L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Michal Dengusiak & Jakub Ziolkowski and contributors"
            VALUE "FileDescription",  "SAM OCCT native wrapper (OpenCASCADE interop for SAM_OCCT)"
            VALUE "FileVersion",      "@SAM_OCCT_FILEVERSION_STR@"
            VALUE "InternalName",     "SAM.Occt.Native.dll"
            VALUE "LegalCopyright",   "Copyright (c) 2020-2026 Michal Dengusiak & Jakub Ziolkowski and contributors"
            VALUE "OriginalFilename", "SAM.Occt.Native.dll"
            VALUE "ProductName",      "SAM_OCCT"
            VALUE "ProductVersion",   "@SAM_OCCT_PRODUCTVERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
