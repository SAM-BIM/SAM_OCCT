<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common test props (TargetFramework, xUnit, coverlet) come from ..\Directory.Build.props -->

  <ItemGroup>
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SAM_OCCT\SAM.Core.OCCT\SAM.Core.OCCT.csproj" />
    <ProjectReference Include="..\..\SAM_OCCT\SAM.Geometry.OCCT\SAM.Geometry.OCCT.csproj" />
    <ProjectReference Include="..\..\SAM_OCCT\SAM.Analytical.OCCT\SAM.Analytical.OCCT.csproj" />
    <ProjectReference Include="..\..\SAM_OCCT\SAM.Geometry.OCCT.Solver\SAM.Geometry.OCCT.Solver.csproj" />
    <ProjectReference Include="..\..\SAM_OCCT\SAM.Analytical.OCCT.Solver\SAM.Analytical.OCCT.Solver.csproj" />
  </ItemGroup>

  <!-- Sibling SAM types used directly by tests; see note in the unit-test project.
       SAM.Analytical / SAM.Math are needed by the .sam fixture tests, which load
       AnalyticalModel / AdjacencyCluster / Panel geometry. -->
  <ItemGroup>
    <Reference Include="SAM.Core">
      <HintPath>..\..\..\SAM\build\SAM.Core.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry">
      <HintPath>..\..\..\SAM\build\SAM.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical">
      <HintPath>..\..\..\SAM\build\SAM.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Math">
      <HintPath>..\..\..\SAM\build\SAM.Math.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.Solver">
      <HintPath>..\..\..\SAM_Solver\build\SAM.Analytical.Solver.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Uploaded SAM geometry fixtures exercised by OcctFixtureIntegrationTests. -->
  <ItemGroup>
    <None Update="Fixtures\*.sam" CopyToOutputDirectory="PreserveNewest" />
    <!-- Pathological models kept out of the top-level scan (which asserts a clean
         build) - exercised explicitly by robustness tests that only require no crash. -->
    <None Update="Fixtures\Robustness\*.sam" CopyToOutputDirectory="PreserveNewest" />
    <!-- PR #49 sample models (the original "walls disappear after Extend3D" bug reports) - kept
         out of the top-level scan for the same reason as Robustness above: these panels are
         deliberately gappy/disconnected and will NOT raw-build watertight without the managed
         conditioning pipeline. Exercised by Extend3DRegressionIntegrationTests. -->
    <None Update="Fixtures\Extend3D-Regression\*.sam" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- P1 (docs/CELLCOMPLEX_FIRST_HANDOVER.md): disables xUnit's default cross-class test-collection
       parallelism. This assembly mixes native-heap-heavy tests (WorkflowParityIntegrationTests now
       runs ~27 OCCT builds per fixture across 9 fixtures) with a memory-growth threshold test
       (HistoryExportIntegrationTests.Build_FiftySuccessiveBuildsWithHistory_NoLeakOrCrash); run
       concurrently they contend for the same process heap and the threshold test flakes on GC
       jitter from unrelated tests, not a real leak (passes cleanly alone or on the pre-P1 suite).
       Serializing collections trades some wall-clock time for a suite that is not flaky by
       construction - the standard fix for this class of native-interop test flake. -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
